{
  "name": "dsh-chat-ctxmenu",
  "version": "2.0.0",
  "type": "module",
  "description": "Adds chat-specific actions to the official DSH context menu: copy the whole message, copy a relative path, and open a file with any registered application. Verifies prose paths on the Host before offering the official file menu.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingofpowers/dsh-chat-ctxmenu.git"
  },
  "homepage": "https://github.com/kingofpowers/dsh-chat-ctxmenu#readme",
  "bugs": {
    "url": "https://github.com/kingofpowers/dsh-chat-ctxmenu/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "context-menu",
    "right-click",
    "file-menu",
    "copy-message"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-context-menu"
      ]
    }
  }
}
